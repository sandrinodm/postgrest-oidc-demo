# Optional. Most settings come from infra/docker/.env; anything set here wins.
# Base URI of PostgREST (required in the Docker image; defaults to
# http://localhost:<POSTGREST_PORT> in development).
# POSTGREST_BASE_URI=http://localhost:3000
# Public URL of this app, used to build the OIDC redirect URI
# (<APP_URL>/auth/callback).
# APP_URL=http://localhost:5173
