# Copy to .env:  cp infra/docker/.env.example infra/docker/.env
# The web app (apps/web) reads this file too, so the OIDC settings only need
# to be set once.

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=postgres
AUTHENTICATOR_PASSWORD=authenticator
POSTGRES_PORT=5432

# --- PostgREST --------------------------------------------------------------
POSTGREST_PORT=3000
POSTGREST_LOG_LEVEL=info

# --- OIDC ---------------------------------------------------------------------
# By default this uses the local OIDC test server (navikt/mock-oauth2-server),
# started by the `oidc-mock` profile below. Its login page accepts any subject
# plus any claims JSON, e.g. {"email": "x@example.com", "groups": ["timeoff-admins"]}.
#
# To use a real provider instead: remove COMPOSE_PROFILES, point OIDC_ISSUER at
# your provider, clear OIDC_JWKS_URI and fill in the client settings.
# To run without OIDC at all: remove COMPOSE_PROFILES, leave OIDC_ISSUER empty
# and set JWT_SECRET below (then only pasted HS256 tokens work).
COMPOSE_PROFILES=oidc-mock
MOCK_OIDC_PORT=8090

# PostgREST also accepts tokens signed by the issuer's keys, and the web app
# shows "Sign in with OIDC".
OIDC_ISSUER=http://localhost:8090/default
# Expected `aud` of the token PostgREST receives. Usually the client id when
# the web app forwards the id_token. Leave empty to skip the audience check.
OIDC_AUDIENCE=postgrest-debugger
# Override the JWKS location instead of discovering it from the issuer. Needed
# when the issuer URL is not reachable from inside Docker, like the localhost
# URL of the test server above.
OIDC_JWKS_URI=http://mock-oidc:8080/default/jwks
# Used by the web app only:
OIDC_CLIENT_ID=postgrest-debugger
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Which token the web app sends to PostgREST: id_token or access_token.
# The access_token only works if your provider issues it as a JWT.
OIDC_FORWARD_TOKEN=id_token

# --- Static secret (optional) ---------------------------------------------------
# HS256 secret (>= 32 chars) for tokens you sign yourself, PostgREST's classic
# setup. Leave empty to only accept OIDC tokens. Needed when OIDC is off.
JWT_SECRET=

# --- Admins -------------------------------------------------------------------
# Anyone whose claims match one of these becomes an admin and can see and
# delete everyone's requests. Applied on every `pnpm infra:up`.
ADMIN_EMAILS=admin@example.com
ADMIN_EMAIL_DOMAINS=
ADMIN_GROUPS=timeoff-admins
ADMIN_GROUPS_CLAIM=$.groups
# Free-form rules, separated by ";": <jsonpath>|<operator>|<value>
# operators: equals, ends_with, starts_with, contains, matches (regex)
# e.g. $.realm_access.roles|equals|admin;$.department|equals|HR
ADMIN_CLAIM_RULES=
ADMIN_REQUIRE_EMAIL_VERIFIED=false
